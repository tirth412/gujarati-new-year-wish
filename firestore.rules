rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /shares/{id} {
      // Anyone can add a share record, but only with the expected fields and sizes.
      allow create: if request.resource.data.keys().hasOnly(['method','to','theme','lang','page','at'])
        && request.resource.data.method in ['whatsapp','copy']
        && request.resource.data.to.size() <= 40;
      // Only the owner can read the log.
      allow read: if request.auth != null
        && request.auth.token.email == 'tirth412@gmail.com'
        && request.auth.token.email_verified == true;
      allow update, delete: if false;
    }

    match /visits/{id} {
      allow create: if request.resource.data.keys().hasOnly(['visitor','src','lang','theme','name','device','returning','at'])
        && request.resource.data.src in ['shared','direct']
        && request.resource.data.device in ['mobile','desktop']
        && request.resource.data.visitor.size() <= 64
        && (!('name' in request.resource.data) || request.resource.data.name.size() <= 40);
      allow read: if request.auth != null
        && request.auth.token.email == 'tirth412@gmail.com'
        && request.auth.token.email_verified == true;
      allow update, delete: if false;
    }
  }
}
